{
    "name": "gildsmith/permission",
    "description": "Permission package for Gildsmith.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Gildsmith\\Permission\\": "src/",
            "Gildsmith\\Permission\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "authors": [
        {
            "name": "Mateusz Chmielewski"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1",
        "pestphp/pest": "^4",
        "pestphp/pest-plugin-type-coverage": "^4",
        "pestphp/pest-plugin-stressless": "^4",
        "phpstan/phpstan": "^2",
        "orchestra/testbench": "^11",
        "gildsmith/testing": "dev-master"
    },
    "require": {
        "php": "^8.5",
        "gildsmith/contract": "dev-master",
        "gildsmith/support": "dev-master",
        "illuminate/support": "^13",
        "illuminate/database": "^13"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "@php vendor/bin/pint --ansi",
            "@php vendor/bin/phpstan analyse src tests --verbose --ansi"
        ],
        "test": [
            "@clear",
            "@php vendor/bin/pest"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gildsmith\\Permission\\Providers\\AppServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../*/*/"
        }
    ]
}
